{
  "name": "demo-zola",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf content/graphql .markdown-copies public",
    "generate": "node ./scripts/generate-docs.mjs && node ./scripts/generate-copies.mjs",
    "dev": "npm run generate && zola serve",
    "build": "npm run generate && zola build && node -e \"require('node:fs').cpSync('.markdown-copies','public',{recursive:true})\"",
    "build:local": "npm run generate && zola build --base-url http://localhost:4173 && node -e \"require('node:fs').cpSync('.markdown-copies','public',{recursive:true})\"",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/graphql": "^1.4.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@graphql-tools/url-loader": "^10.0.9",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
